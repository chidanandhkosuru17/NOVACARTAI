rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kosuruavinay@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['customer', 'retailer', 'admin', 'executive'];
    }

    function isValidStore(data) {
      return data.keys().hasAll(['name', 'category', 'location', 'status']) &&
             data.name is string && data.name.size() <= 150 &&
             data.category is string && data.category.size() <= 80 &&
             data.location is string && data.location.size() <= 150 &&
             data.status in ['Open', 'Closed', 'Busy'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['storeId', 'name', 'category', 'price', 'stock', 'stockStatus']) &&
             data.storeId is string && data.storeId.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 80 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.stockStatus in ['In Stock', 'Low Stock', 'Out of Stock'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerId', 'storeId', 'items', 'total', 'status', 'paymentMethod', 'deliveryAddress']) &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.storeId is string && data.storeId.size() <= 128 &&
             data.items is list && data.items.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.status in ['Order Placed', 'Retailer Accepted', 'Preparing Order', 'Ready for Pickup', 'Out for Delivery', 'Delivered', 'Cancelled', 'Delayed'] &&
             data.deliveryAddress is string && data.deliveryAddress.size() <= 300;
    }

    function isValidSimulation(data) {
      return data.keys().hasAll(['userId', 'scenarioName', 'targetRepeatRate', 'targetCancellationRate']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.scenarioName is string && data.scenarioName.size() <= 200 &&
             data.targetRepeatRate is number && data.targetRepeatRate >= 0 && data.targetRepeatRate <= 100 &&
             data.targetCancellationRate is number && data.targetCancellationRate >= 0 && data.targetCancellationRate <= 100;
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['userId', 'customerName', 'category', 'priority', 'status']) &&
             data.userId is string &&
             data.customerName is string && data.customerName.size() <= 150 &&
             data.category in ['Refund', 'Delivery delay', 'Missing product', 'Coupon issue', 'Incorrect order', 'Other'] &&
             data.priority in ['Low', 'Medium', 'High', 'Critical'] &&
             data.status in ['Open', 'In Progress', 'Resolved', 'Escalated'];
    }

    function isValidCampaign(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'targetSegment', 'budget', 'status']) &&
             data.userId is string &&
             data.name is string && data.name.size() <= 150 &&
             data.type in ['First-order offer', 'Repeat purchase reward', 'Lapsed customer reactivation', 'Category-based promotion', 'Nearby retailer promotion', 'Referral campaign'] &&
             data.budget is number && data.budget >= 0 &&
             data.status in ['Active', 'Paused', 'Draft', 'Completed'];
    }

    // Stores Collection (Public read for neighborhood store discovery)
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidStore(incoming());
      allow update: if isSignedIn() && isValidStore(incoming());
      allow delete: if isAdmin();
    }

    // Products Collection (Public read for customer browsing)
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidProduct(incoming());
      allow delete: if isSignedIn();
    }

    // Orders Collection (Shared connected order pipeline)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isSignedIn() && isValidOrder(incoming());
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isAdmin();
    }

    // Simulations Collection
    match /simulations/{simId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidSimulation(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidSimulation(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Support Tickets Collection
    match /tickets/{ticketId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidTicket(incoming());
      allow update: if isSignedIn() && isValidTicket(incoming());
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Campaigns Collection
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidCampaign(incoming());
      allow update: if isSignedIn() && isValidCampaign(incoming());
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }
  }
}
